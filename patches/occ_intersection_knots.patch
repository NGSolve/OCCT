+//=======================================================================
+// function : InsertKnotCrossings
+// purpose  : The parametrization of a B-spline surface is only C0 at knots
+//            with multiplicity >= degree, the parameter curves of the
+//            intersection have a kink there. The walking line may step over
+//            such a knot line with a large step, the approximation then
+//            overshoots between the two points (it measures its error only
+//            at the points of the line). Insert the exact intersection points
+//            on these knot lines into the walking line.
+//=======================================================================
+static void InsertKnotCrossings(const occ::handle<IntPatch_WLine>&      theWL,
+                                const occ::handle<GeomAdaptor_Surface>& theS1,
+                                const occ::handle<GeomAdaptor_Surface>& theS2)
+{
+  struct KnotLine
+  {
+    int    myParam; // index in (U1, V1, U2, V2)
+    double myValue;
+  };
+
+  std::vector<KnotLine>                  aKnots;
+  const occ::handle<GeomAdaptor_Surface> aSurfs[2] = {theS1, theS2};
+  for (int s = 0; s < 2; ++s)
+  {
+    if (aSurfs[s]->GetType() != GeomAbs_BSplineSurface)
+    {
+      continue;
+    }
+    const occ::handle<Geom_BSplineSurface> aBS = aSurfs[s]->BSpline();
+    for (int i = 2; i < aBS->NbUKnots(); ++i)
+    {
+      if (aBS->UMultiplicity(i) >= aBS->UDegree())
+      {
+        aKnots.push_back({2 * s, aBS->UKnot(i)});
+      }
+    }
+    for (int i = 2; i < aBS->NbVKnots(); ++i)
+    {
+      if (aBS->VMultiplicity(i) >= aBS->VDegree())
+      {
+        aKnots.push_back({2 * s + 1, aBS->VKnot(i)});
+      }
+    }
+  }
+  if (aKnots.empty())
+  {
+    return;
+  }
+
+  const occ::handle<IntSurf_LineOn2S> aLine = theWL->Curve();
+  const int                           aNb   = aLine->NbPoints();
+
+  std::vector<int> aNbIns(aNb + 1, 0);
+  for (int k = aNb - 1; k >= 1; --k)
+  {
+    double a[4], b[4];
+    aLine->Value(k).Parameters(a[0], a[1], a[2], a[3]);
+    aLine->Value(k + 1).Parameters(b[0], b[1], b[2], b[3]);
+    std::vector<std::pair<double, IntSurf_PntOn2S>> aNew;
+    for (const KnotLine& aKL : aKnots)
+    {
+      const int    p  = aKL.myParam;
+      const double kv = aKL.myValue;
+      if ((a[p] - kv) * (b[p] - kv) >= 0. || std::abs(b[p] - a[p]) < Precision::PConfusion())
+      {
+        continue;
+      }
+      const double aFrac = (kv - a[p]) / (b[p] - a[p]);
+      double       x[4];
+      for (int j = 0; j < 4; ++j)
+      {
+        x[j] = a[j] + aFrac * (b[j] - a[j]);
+      }
+      x[p] = kv;
+      // Newton for S1(x0, x1) = S2(x2, x3) with x[p] fixed
+      bool   isDone = false;
+      gp_Pnt aP1, aP2;
+      for (int it = 0; it < 30 && !isDone; ++it)
+      {
+        gp_Vec aD[4];
+        theS1->D1(x[0], x[1], aP1, aD[0], aD[1]);
+        theS2->D1(x[2], x[3], aP2, aD[2], aD[3]);
+        aD[2].Reverse();
+        aD[3].Reverse();
+        const gp_Vec aF(aP2, aP1);
+        if (aF.Magnitude() < Precision::Confusion() * 1.e-3)
+        {
+          isDone = true;
+          break;
+        }
+        int aCol[3], n = 0;
+        for (int j = 0; j < 4; ++j)
+        {
+          if (j != p)
+          {
+            aCol[n++] = j;
+          }
+        }
+        const double aDet = aD[aCol[0]].DotCross(aD[aCol[1]], aD[aCol[2]]);
+        if (std::abs(aDet) < 1.e-30)
+        {
+          break;
+        }
+        // Cramer: J * dx = -F
+        const gp_Vec aR = -aF;
+        x[aCol[0]] += aR.DotCross(aD[aCol[1]], aD[aCol[2]]) / aDet;
+        x[aCol[1]] += aD[aCol[0]].DotCross(aR, aD[aCol[2]]) / aDet;
+        x[aCol[2]] += aD[aCol[0]].DotCross(aD[aCol[1]], aR) / aDet;
+      }
+      if (!isDone)
+      {
+        continue;
+      }
+      // the solution must lie between the two points of the line; the parameters
+      // are not monotonic across the knot line, compare the distances in 3D
+      const gp_Pnt aPM((aP1.XYZ() + aP2.XYZ()) * 0.5);
+      const gp_Pnt aPA = aLine->Value(k).Value(), aPB = aLine->Value(k + 1).Value();
+      const double aChord = aPA.Distance(aPB) + Precision::Confusion();
+      if (aPM.Distance(aPA) > aChord || aPM.Distance(aPB) > aChord)
+      {
+        continue;
+      }
+      IntSurf_PntOn2S aPnt;
+      aPnt.SetValue(aPM, x[0], x[1], x[2], x[3]);
+      aNew.emplace_back(aFrac, aPnt);
+    }
+    std::sort(aNew.begin(), aNew.end(), [](const auto& l, const auto& r) {
+      return l.first < r.first;
+    });
+    for (size_t j = 0; j < aNew.size(); ++j)
+    {
+      aLine->InsertBefore(k + 1 + (int)j, aNew[j].second);
+    }
+    aNbIns[k] = (int)aNew.size();
+  }
+
+  // shift the vertex parameters (point indices) of the line
+  std::vector<double> aMap(aNb + 1, 0.);
+  int                 aShift = 0;
+  for (int k = 1; k <= aNb; ++k)
+  {
+    aMap[k] = k + aShift;
+    aShift += aNbIns[k];
+  }
+  if (aShift == 0)
+  {
+    return;
+  }
+  NCollection_Sequence<IntPatch_Point> aVtx;
+  for (int v = 1; v <= theWL->NbVertex(); ++v)
+  {
+    IntPatch_Point aV  = theWL->Vertex(v);
+    const double   aPL = aV.ParameterOnLine();
+    const int      m   = std::max(1, std::min(aNb, (int)std::floor(aPL + 1.e-9)));
+    const double   aFr = aPL - m;
+    const double   aNP = (m < aNb) ? aMap[m] + aFr * (aMap[m + 1] - aMap[m]) : aMap[m] + aFr;
+    aV.SetParameter(aNP);
+    aVtx.Append(aV);
+  }
+  theWL->ClearVertexes();
+  for (const IntPatch_Point& aV : aVtx)
+  {
+    theWL->AddVertex(aV);
+  }
+}
