+//=======================================================================
+// function : IsOnKnotLine
+// purpose  : True if the point lies exactly on a C0 knot line of one of the
+//            B-spline surfaces (inserted by InsertKnotCrossings)
+//=======================================================================
+static bool IsOnKnotLine(const IntSurf_PntOn2S&                  thePnt,
+                         const occ::handle<GeomAdaptor_Surface>& theS1,
+                         const occ::handle<GeomAdaptor_Surface>& theS2)
+{
+  double aPrm[4];
+  thePnt.Parameters(aPrm[0], aPrm[1], aPrm[2], aPrm[3]);
+  const occ::handle<GeomAdaptor_Surface> aSurfs[2] = {theS1, theS2};
+  for (int s = 0; s < 2; ++s)
+  {
+    if (aSurfs[s]->GetType() != GeomAbs_BSplineSurface)
+    {
+      continue;
+    }
+    const occ::handle<Geom_BSplineSurface> aBS = aSurfs[s]->BSpline();
+    for (int i = 2; i < aBS->NbUKnots(); ++i)
+    {
+      if (aBS->UMultiplicity(i) >= aBS->UDegree() && aPrm[2 * s] == aBS->UKnot(i))
+      {
+        return true;
+      }
+    }
+    for (int i = 2; i < aBS->NbVKnots(); ++i)
+    {
+      if (aBS->VMultiplicity(i) >= aBS->VDegree() && aPrm[2 * s + 1] == aBS->VKnot(i))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ConcatBSplines
+// purpose  : Joins clamped B-spline curves (C0 at the joints) after shifting
+//            piece i by theOffsets[i]
+//=======================================================================
+static gp_Pnt MidPoint(const gp_Pnt& a, const gp_Pnt& b)
+{
+  return gp_Pnt((a.XYZ() + b.XYZ()) * 0.5);
+}
+
+static gp_Pnt2d MidPoint(const gp_Pnt2d& a, const gp_Pnt2d& b)
+{
+  return gp_Pnt2d((a.XY() + b.XY()) * 0.5);
+}
+
+template <class TC, class TP>
+static occ::handle<TC> ConcatBSplines(const std::vector<occ::handle<TC>>& theCurves,
+                                      const std::vector<double>&          theOffsets)
+{
+  int aDeg = 0;
+  for (const occ::handle<TC>& c : theCurves)
+  {
+    if (c.IsNull() || c->IsPeriodic() || c->Multiplicity(1) != c->Degree() + 1
+        || c->Multiplicity(c->NbKnots()) != c->Degree() + 1)
+    {
+      return occ::handle<TC>();
+    }
+    aDeg = std::max(aDeg, c->Degree());
+  }
+  std::vector<TP>     aPoles;
+  std::vector<double> aKnots;
+  std::vector<int>    aMults;
+  for (size_t i = 0; i < theCurves.size(); ++i)
+  {
+    occ::handle<TC> c = occ::down_cast<TC>(theCurves[i]->Copy());
+    c->IncreaseDegree(aDeg);
+    const int aFirst = (i == 0) ? 1 : 2;
+    if (i > 0)
+    {
+      aMults.back() = aDeg;
+      aPoles.back() = MidPoint(aPoles.back(), c->Pole(1));
+    }
+    for (int k = aFirst; k <= c->NbPoles(); ++k)
+    {
+      aPoles.push_back(c->Pole(k));
+    }
+    for (int k = aFirst; k <= c->NbKnots(); ++k)
+    {
+      aKnots.push_back(c->Knot(k) + theOffsets[i]);
+      aMults.push_back(c->Multiplicity(k));
+    }
+  }
+  NCollection_Array1<TP>     aP(1, (int)aPoles.size());
+  NCollection_Array1<double> aK(1, (int)aKnots.size());
+  NCollection_Array1<int>    aM(1, (int)aMults.size());
+  for (size_t k = 0; k < aPoles.size(); ++k)
+  {
+    aP((int)k + 1) = aPoles[k];
+  }
+  for (size_t k = 0; k < aKnots.size(); ++k)
+  {
+    aK((int)k + 1) = aKnots[k];
+    aM((int)k + 1) = aMults[k];
+  }
+  return new TC(aP, aK, aM, aDeg);
+}
+
+//=======================================================================
+// function : JoinCurves
+// purpose  : Replaces the consecutive curves theFirst..theLast of theSeq
+//            (pieces of one intersection line split at knot lines of the
+//            surfaces) by one curve
+//=======================================================================
+static void JoinCurves(NCollection_Sequence<IntTools_Curve>& theSeq,
+                       const int                             theFirst,
+                       const int                             theLast)
+{
+  if (theLast <= theFirst)
+  {
+    return;
+  }
+  std::vector<occ::handle<Geom_BSplineCurve>>   aC3;
+  std::vector<occ::handle<Geom2d_BSplineCurve>> aC1, aC2;
+  std::vector<double>                           aOffsets;
+  double                                        aTol = 0., aTangTol = 0., aEnd = 0.;
+  bool                                          isNull1 = false, isNull2 = false;
+  for (int i = theFirst; i <= theLast; ++i)
+  {
+    const IntTools_Curve&                aIC = theSeq(i);
+    const occ::handle<Geom_BSplineCurve> aBS = occ::down_cast<Geom_BSplineCurve>(aIC.Curve());
+    if (aBS.IsNull())
+    {
+      return;
+    }
+    if (i > theFirst && aC3.back()->EndPoint().Distance(aBS->StartPoint()) > Precision::Confusion())
+    {
+      return;
+    }
+    aOffsets.push_back(i == theFirst ? 0. : aEnd - aBS->FirstParameter());
+    aEnd = aBS->LastParameter() + aOffsets.back();
+    aC3.push_back(aBS);
+    aC1.push_back(occ::down_cast<Geom2d_BSplineCurve>(aIC.FirstCurve2d()));
+    aC2.push_back(occ::down_cast<Geom2d_BSplineCurve>(aIC.SecondCurve2d()));
+    isNull1 |= aIC.FirstCurve2d().IsNull();
+    isNull2 |= aIC.SecondCurve2d().IsNull();
+    aTol     = std::max(aTol, aIC.Tolerance());
+    aTangTol = std::max(aTangTol, aIC.TangentialTolerance());
+  }
+  const occ::handle<Geom_BSplineCurve> aJ3 =
+    ConcatBSplines<Geom_BSplineCurve, gp_Pnt>(aC3, aOffsets);
+  occ::handle<Geom2d_BSplineCurve> aJ1, aJ2;
+  if (!isNull1)
+  {
+    aJ1 = ConcatBSplines<Geom2d_BSplineCurve, gp_Pnt2d>(aC1, aOffsets);
+  }
+  if (!isNull2)
+  {
+    aJ2 = ConcatBSplines<Geom2d_BSplineCurve, gp_Pnt2d>(aC2, aOffsets);
+  }
+  if (aJ3.IsNull() || (!isNull1 && aJ1.IsNull()) || (!isNull2 && aJ2.IsNull()))
+  {
+    return;
+  }
+  IntTools_Curve aRes;
+  aRes.SetCurve(aJ3);
+  aRes.SetFirstCurve2d(aJ1);
+  aRes.SetSecondCurve2d(aJ2);
+  aRes.SetTolerance(aTol);
+  aRes.SetTangentialTolerance(aTangTol);
+  theSeq.Remove(theFirst, theLast);
+  if (theFirst > theSeq.Length())
+  {
+    theSeq.Append(aRes);
+  }
+  else
+  {
+    theSeq.InsertBefore(theFirst, aRes);
+  }
+}
